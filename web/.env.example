# Postgres connection string (Neon / Vercel Postgres / any Postgres).
# Leave unset for local dev: an embedded PGlite database is used in web/.data/.
DATABASE_URL=

# Public base URL of this deployment, used in install commands and OG cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the agent binaries are hosted (GitHub release, Vercel Blob, S3...).
# Files must be named vm-vitals-<os>-<arch> (e.g. vm-vitals-linux-amd64).
# Leave unset to serve from web/public/dl/ (fine for local dev).
RELEASE_BASE_URL=

# Email for magic-link claims. Leave unset to print the link to the server log.
RESEND_API_KEY=
EMAIL_FROM=VM Vitals <vitals@example.com>

# Random secret for signing session cookies. Any long random string.
SESSION_SECRET=
